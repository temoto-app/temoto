{
  "extends": "./tsconfig.base.json",
  // plugins/ も renderer と同じ DOM 環境で動く (iframe の中)。
  // ここで型検査しておくと、境界 lint と合わせて二重に守れる。
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/shared/**/*.ts",
    "src/preload/index.ts",
    "plugins/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@pluginshared/*": ["plugins/_shared/*"]
    }
  }
}

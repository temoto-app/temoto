{
  "extends": "./tsconfig.base.json",
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/common/**/*.ts",
    "src/index-kernel/**/*.ts",
    "src/index-host/**/*.ts",
    "src/main/**/*.ts",
    "src/gateway/**/*.ts",
    "src/plugin-host/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts"
  ],
  // shared/markdown は renderer とプラグインだけが使うブラウザ専用のコード
  // (DOMPurify が DOM を要求する)。main / gateway は読まないので外す。
  "exclude": ["src/shared/markdown/**"],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      // このパッケージの package.json "exports" が types を指していないため、
      // 同梱の index.d.ts を直接参照する。
      "better-sqlite3-multiple-ciphers": ["node_modules/better-sqlite3-multiple-ciphers/index.d.ts"]
    }
  }
}

{
  "name": "aios",
  "productName": "aios",
  "version": "0.105.1",
  "description": "AI ネイティブなデスクトップシェル",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run build:app",
    "build:app": "electron-vite build && npm run build:plugins && npm run build:local-provider && npm run build:speech && npm run build:pdf && npm run build:vision && npm run build:input-source && npm run test:bundle",
    "check": "node scripts/check.mjs",
    "clean": "node scripts/clean.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "npm run lint:terms && npm run lint:plugins && npm run lint:index && npm run lint:os && npm run lint:settings-owner && npm run lint:docs && npm run lint:comments && npm run lint:test-names && eslint .",
    "lint:terms": "node scripts/lint-forbidden-terms.mjs",
    "lint:plugins": "node scripts/lint-plugin-boundaries.mjs",
    "lint:index": "node scripts/lint-index-boundaries.mjs",
    "lint:os": "node scripts/lint-os-boundaries.mjs",
    "lint:settings-owner": "node scripts/lint-settings-owner.mjs",
    "lint:docs": "node scripts/check-doc-shrink.mjs",
    "lint:comments": "node scripts/lint-comments.mjs",
    "lint:test-names": "node scripts/test-names-i18n.mjs check test",
    "docs:html": "node scripts/md-to-html.mjs docs/notes/repos.md",
    "build:plugins": "node scripts/build-plugins.mjs",
    "build:local-provider": "node scripts/build-local-provider.mjs",
    "build:speech": "sh tools/speech-helper/build.sh",
    "build:pdf": "sh tools/pdf-helper/build.sh",
    "build:vision": "sh tools/vision-helper/build.sh",
    "build:input-source": "sh tools/input-source-helper/build.sh",
    "icon": "node scripts/make-icon.mjs",
    "app": "npm run build && node scripts/make-app.mjs",
    "release": "node scripts/release.mjs",
    "plugin-signing:keygen": "node scripts/plugin-signing-keygen.mjs",
    "dev:instance": "sh scripts/dev-instance.sh",
    "smoke": "node scripts/smoke/run.mjs",
    "promote": "sh scripts/promote-stable.sh",
    "reboot": "sh scripts/reboot-stable.sh",
    "verify:selfsign": "bash scripts/verify-selfsign.sh all",
    "verify:sign": "bash scripts/verify-sign.sh",
    "test": "vitest run",
    "test:bundle": "vitest run test/index-bundle.test.ts test/build-stamp-bundle.test.ts test/renderer-csp.test.ts test/local-provider-bundle.test.ts",
    "test:watch": "vitest",
    "rebuild": "electron-rebuild -f -m . -w better-sqlite3-multiple-ciphers,@parcel/watcher",
    "postinstall": "electron-rebuild -f -m . -w better-sqlite3-multiple-ciphers,@parcel/watcher",
    "test:contract": "vitest run --config vitest.contract.config.ts"
  },
  "dependencies": {
    "@codemirror/search": "^6.7.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@parcel/watcher": "^2.6.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "kuromoji": "^0.1.2",
    "tldts": "^7.4.18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.9.0",
    "@codemirror/language": "^6.11.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@electron/rebuild": "^4.2.0",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/kuromoji": "^0.1.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.15",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.2.0",
    "ollama-ai-provider-v2": "3.6.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "ollama-ai-provider-v2": {
      "zod": "$zod"
    }
  }
}

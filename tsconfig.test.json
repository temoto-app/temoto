{
  "extends": "./tsconfig.base.json",
  "include": ["test/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "plugins/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    // テストは main (Node) と renderer (DOM) の両方に手を伸ばすので lib を両方入れる。
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@pluginshared/*": ["plugins/_shared/*"],
      "better-sqlite3-multiple-ciphers": ["node_modules/better-sqlite3-multiple-ciphers/index.d.ts"]
    }
  }
}
